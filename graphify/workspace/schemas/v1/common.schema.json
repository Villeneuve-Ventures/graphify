{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/workspace/v1/common.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:/|/{1,2}(?!/)(?!\\.{1,2}(?:/|$))(?![\\s\\S]*/\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!\\.{1,2}(?:/|$))(?![\\s\\S]*/\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*)$"
    },
    "remoteAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "evidence_sha256"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(?:https://(?=[\\u0000-\\u007f]+/)(?![^/]*[A-Z])[^\\s/:@?#\\[\\]\\u0000]+|ssh://(?:[^\\s/:?#\\[\\]\\u0000]+@)?(?=[\\u0000-\\u007f]+/)(?![^/]*[A-Z])[^\\s/:@?#\\[\\]\\u0000]+)(?:/(?!\\.{1,2}(?:/|$))[^\\s/?#%\\\\\\u0000]+)+$"
        },
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_common_dir", "worktree_id", "remote_aliases"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "git_common_dir": {"$ref": "#/$defs/absolutePath"},
        "worktree_id": {"type": "string", "minLength": 1},
        "remote_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/remoteAlias"}
        }
      }
    },
    "payloadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_type", "size", "sha256", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "file_type": {"const": "regular_file"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"enum": ["0600", "0644", "0755"]}
      }
    },
    "sealedPayloadEntry": {
      "allOf": [
        {"$ref": "#/$defs/payloadEntry"},
        {
          "properties": {
            "path": {"type": "string", "pattern": "^graphify-out/.+"}
          }
        }
      ]
    },
    "pointerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "receipt_sha256"],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pointerSetBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "repo_uuid",
        "pointer_revision",
        "active_source_revision",
        "source_epoch",
        "operation_epoch",
        "fence_token",
        "state_schema_version",
        "current",
        "last_good"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.pointer_set"},
        "schema_version": {"const": 1},
        "repo_uuid": {"$ref": "#/$defs/uuid"},
        "pointer_revision": {"type": "integer", "minimum": 1},
        "active_source_revision": {"type": "integer", "minimum": 1},
        "source_epoch": {"type": "integer", "minimum": 1},
        "operation_epoch": {"type": "integer", "minimum": 1},
        "fence_token": {"type": "integer", "minimum": 1},
        "state_schema_version": {"const": 1},
        "current": {"$ref": "#/$defs/pointerRef"},
        "last_good": {
          "oneOf": [
            {"$ref": "#/$defs/pointerRef"},
            {"type": "null"}
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_revision",
        "active_source_revision",
        "operation_epoch",
        "fence_token",
        "state_schema_version",
        "source_commit",
        "inventory_sha256",
        "policy_sha256",
        "detector_id",
        "receipt_sha256",
        "payload_manifest_sha256",
        "stable_inventory_passes"
      ],
      "properties": {
        "pointer_revision": {"type": "integer", "minimum": 1},
        "active_source_revision": {"type": "integer", "minimum": 1},
        "operation_epoch": {"type": "integer", "minimum": 1},
        "fence_token": {"type": "integer", "minimum": 1},
        "state_schema_version": {"const": 1},
        "source_commit": {"$ref": "#/$defs/commit"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "detector_id": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "payload_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "stable_inventory_passes": {"const": 2}
      }
    },
    "installItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before_sha256", "after_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "before_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "repo_uuid", "policy"],
      "properties": {
        "contract": {"const": "graphify.workspace.config"},
        "schema_version": {"const": 1},
        "repo_uuid": {"$ref": "#/$defs/uuid"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["freshness", "semantic_mode", "network_egress", "headless_backends"],
          "properties": {
            "freshness": {"const": "current_only"},
            "semantic_mode": {"enum": ["host_agent_only", "explicit_backend"]},
            "network_egress": {"type": "boolean"},
            "headless_backends": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"semantic_mode": {"const": "host_agent_only"}}},
              "then": {"properties": {"headless_backends": {"maxItems": 0}}}
            }
          ]
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "revision", "workspaces"],
      "properties": {
        "contract": {"const": "graphify.workspace.registry"},
        "schema_version": {"const": 1},
        "revision": {"type": "integer", "minimum": 1},
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo_uuid",
              "uuid_enrollment",
              "active_source_revision",
              "active_source",
              "active_source_evidence",
              "aliases"
            ],
            "properties": {
              "repo_uuid": {"$ref": "#/$defs/uuid"},
              "uuid_enrollment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo_uuid",
                  "immutable_evidence_sha256",
                  "current_evidence_sha256"
                ],
                "properties": {
                  "repo_uuid": {"$ref": "#/$defs/uuid"},
                  "immutable_evidence_sha256": {"$ref": "#/$defs/sha256"},
                  "current_evidence_sha256": {"$ref": "#/$defs/sha256"}
                }
              },
              "active_source_revision": {"type": "integer", "minimum": 1},
              "active_source": {"$ref": "#/$defs/source"},
              "active_source_evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "active_source_revision",
                  "source_sha256",
                  "rebind_evidence_sha256",
                  "operation_epoch",
                  "fence_token"
                ],
                "properties": {
                  "active_source_revision": {"type": "integer", "minimum": 1},
                  "source_sha256": {"$ref": "#/$defs/sha256"},
                  "rebind_evidence_sha256": {"$ref": "#/$defs/sha256"},
                  "operation_epoch": {"type": "integer", "minimum": 1},
                  "fence_token": {"type": "integer", "minimum": 1}
                }
              },
              "aliases": {"type": "array", "items": {"$ref": "#/$defs/source"}}
            }
          }
        }
      }
    },
    "generationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "repo_uuid",
        "generation_id",
        "lifecycle_state",
        "source_commit",
        "source_epoch",
        "active_source_revision",
        "operation_epoch",
        "fence_token",
        "policy_sha256",
        "observation_manifest_sha256",
        "queue_watermark",
        "semantic_completeness",
        "compatibility_sha256",
        "coordination_lock_id",
        "sealed_query_payload",
        "validations"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.generation_receipt"},
        "schema_version": {"const": 1},
        "repo_uuid": {"$ref": "#/$defs/uuid"},
        "generation_id": {"type": "string", "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"},
        "lifecycle_state": {"const": "CERTIFIED"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_epoch": {"type": "integer", "minimum": 1},
        "active_source_revision": {"type": "integer", "minimum": 1},
        "operation_epoch": {"type": "integer", "minimum": 1},
        "fence_token": {"type": "integer", "minimum": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "observation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "queue_watermark": {"type": "integer", "minimum": 0},
        "semantic_completeness": {"enum": ["complete", "not_required", "pending_rejected"]},
        "compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "coordination_lock_id": {"type": "string", "pattern": "^generation:[a-z0-9][a-z0-9._-]{0,62}$"},
        "sealed_query_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "manifest_sha256", "entries"],
          "properties": {
            "root": {"const": "graphify-out"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "entries": {
              "type": "array",
              "items": {"$ref": "#/$defs/sealedPayloadEntry"}
            }
          }
        },
        "validations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "journalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "event_id",
        "sequence",
        "transition",
        "generation_id",
        "prior_event_sha256",
        "receipt_sha256",
        "pointer_revision",
        "operation_epoch",
        "fence_token",
        "occurred_at"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.journal_event"},
        "schema_version": {"const": 1},
        "event_id": {"$ref": "#/$defs/uuid"},
        "sequence": {"type": "integer", "minimum": 1},
        "transition": {
          "enum": ["ALLOCATED", "STAGING", "BUILT", "VALIDATING", "CERTIFIED", "PROMOTED", "FAILED", "SUPERSEDED", "REPAIRED", "ROLLED_BACK"]
        },
        "generation_id": {"type": "string", "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"},
        "prior_event_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "receipt_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "pointer_revision": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "operation_epoch": {"type": "integer", "minimum": 1},
        "fence_token": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
          "then": {"properties": {"prior_event_sha256": {"type": "null"}}},
          "else": {"properties": {"prior_event_sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {
            "properties": {
              "transition": {
                "enum": ["ALLOCATED", "STAGING", "BUILT", "VALIDATING", "FAILED"]
              }
            },
            "required": ["transition"]
          },
          "then": {
            "properties": {
              "receipt_sha256": {"type": "null"},
              "pointer_revision": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "receipt_sha256": {"$ref": "#/$defs/sha256"},
              "pointer_revision": {"type": "integer", "minimum": 0}
            }
          }
        }
      ]
    },
    "fencedLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "repo_uuid",
        "operation",
        "fence_token",
        "owner",
        "acquired_at",
        "heartbeat_at",
        "liveness_deadline_monotonic_ns"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.fenced_lease"},
        "schema_version": {"const": 1},
        "repo_uuid": {"$ref": "#/$defs/uuid"},
        "operation": {"enum": ["ACTIVATE", "BUILD", "GC", "MIGRATE", "POINTER_RECOVERY", "PROMOTE", "REPAIR", "ROLLBACK", "SEMANTIC_CLAIM"]},
        "fence_token": {"type": "integer", "minimum": 1},
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boot_id", "pid", "process_start_id"],
          "properties": {
            "boot_id": {"type": "string", "minLength": 1},
            "pid": {"type": "integer", "minimum": 1},
            "process_start_id": {"type": "string", "minLength": 1}
          }
        },
        "acquired_at": {"type": "string", "format": "date-time"},
        "heartbeat_at": {"type": "string", "format": "date-time"},
        "liveness_deadline_monotonic_ns": {"type": "integer", "minimum": 1}
      }
    },
    "pointerSet": {"$ref": "#/$defs/pointerSetBody"},
    "priorPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "retained_at", "replaced_by_revision", "pointer_set"],
      "properties": {
        "contract": {"const": "graphify.workspace.prior_pointer"},
        "schema_version": {"const": 1},
        "retained_at": {"type": "string", "format": "date-time"},
        "replaced_by_revision": {"type": "integer", "minimum": 2},
        "pointer_set": {"$ref": "#/$defs/pointerSetBody"}
      }
    },
    "generationCoordinationLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "lock_id",
        "generation_id",
        "relative_path",
        "installed_before_state",
        "query_lock",
        "gc_lock",
        "retention"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.generation_coordination_lock"},
        "schema_version": {"const": 1},
        "lock_id": {"type": "string", "pattern": "^generation:[a-z0-9][a-z0-9._-]{0,62}$"},
        "generation_id": {"type": "string", "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"},
        "relative_path": {"type": "string", "pattern": "^locks/generations/gen-[a-z0-9][a-z0-9._-]{0,62}\\.lock$"},
        "installed_before_state": {"const": "CERTIFIED"},
        "query_lock": {"const": "read_only_shared_advisory"},
        "gc_lock": {"const": "exclusive_then_reachability_recheck"},
        "retention": {"const": "retain_v1"}
      }
    },
    "freshnessRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "policy", "pre_observation", "post_observation", "release_decision", "reason", "limitations"],
      "properties": {
        "contract": {"const": "graphify.workspace.freshness_release"},
        "schema_version": {"const": 1},
        "policy": {"const": "current_only"},
        "pre_observation": {"$ref": "#/$defs/observation"},
        "post_observation": {"$ref": "#/$defs/observation"},
        "release_decision": {"enum": ["release", "withhold"]},
        "reason": {"enum": ["observed_current", "drift", "unstable", "unsupported", "timeout", "source_unavailable"]},
        "limitations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strict_source_linearizability", "inter_observation_aba_detection", "post_boundary_changes"],
          "properties": {
            "strict_source_linearizability": {"const": false},
            "inter_observation_aba_detection": {"const": false},
            "post_boundary_changes": {"const": "out_of_scope"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"release_decision": {"const": "release"}}},
          "then": {"properties": {"reason": {"const": "observed_current"}}}
        }
      ]
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "manifest_version", "artifacts"],
      "properties": {
        "contract": {"const": "graphify.workspace.artifact_manifest"},
        "schema_version": {"const": 1},
        "manifest_version": {"const": 1},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/payloadEntry"}}
      }
    },
    "compatibilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "distribution",
        "distribution_version",
        "distribution_build",
        "engine_baseline",
        "upstream_commit",
        "fork_commit",
        "extractor_cache_abi",
        "python",
        "platform",
        "state_schema_version",
        "adapter_contract_version",
        "cli_contract_version",
        "runtime_lock_sha256",
        "skill_bundle_sha256",
        "contract_bundle_sha256",
        "fixture_manifest_sha256",
        "provenance_sha256",
        "sbom_sha256",
        "artifacts"
      ],
      "properties": {
        "contract": {"const": "graphify.workspace.compatibility_manifest"},
        "schema_version": {"const": 1},
        "distribution": {"const": "graphifyy"},
        "distribution_version": {"const": "0.9.16+workspace.1"},
        "distribution_build": {"type": "string", "minLength": 1},
        "engine_baseline": {"const": "0.9.16"},
        "upstream_commit": {"const": "a0e4a1c6bd3a99edfdd84ad30927003f51face6a"},
        "fork_commit": {"$ref": "#/$defs/commit"},
        "extractor_cache_abi": {"const": "graphify-0.9.16"},
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "state_schema_version": {"const": 1},
        "adapter_contract_version": {"const": 1},
        "cli_contract_version": {"const": 1},
        "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
        "skill_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "contract_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_sha256": {"$ref": "#/$defs/sha256"},
        "sbom_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract-bundle.zip",
            "fixture-bundle.zip",
            "fixture-manifest.json",
            "graphifyy-0.9.16+workspace.1-py3-none-any.whl",
            "offline-rollback.zip",
            "provenance.json",
            "runtime-bundle.zip",
            "runtime-requirements.txt",
            "sbom.cdx.json",
            "skill-bundle.zip"
          ],
          "properties": {
            "contract-bundle.zip": {"$ref": "#/$defs/sha256"},
            "fixture-bundle.zip": {"$ref": "#/$defs/sha256"},
            "fixture-manifest.json": {"$ref": "#/$defs/sha256"},
            "graphifyy-0.9.16+workspace.1-py3-none-any.whl": {"$ref": "#/$defs/sha256"},
            "offline-rollback.zip": {"$ref": "#/$defs/sha256"},
            "provenance.json": {"$ref": "#/$defs/sha256"},
            "runtime-bundle.zip": {"$ref": "#/$defs/sha256"},
            "runtime-requirements.txt": {"$ref": "#/$defs/sha256"},
            "sbom.cdx.json": {"$ref": "#/$defs/sha256"},
            "skill-bundle.zip": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "installerTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "transaction_id", "phase", "home", "codex_home", "candidate_manifest_sha256", "items", "compensation_plan_sha256", "generation_disposition"],
      "properties": {
        "contract": {"const": "graphify.workspace.installer_transaction"},
        "schema_version": {"const": 1},
        "transaction_id": {"$ref": "#/$defs/uuid"},
        "phase": {"enum": ["PREPARED", "STAGED", "SWITCHED", "VERIFIED", "COMPENSATING", "ROLLED_BACK"]},
        "home": {"$ref": "#/$defs/absolutePath"},
        "codex_home": {"$ref": "#/$defs/absolutePath"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/installItem"}
        },
        "compensation_plan_sha256": {"$ref": "#/$defs/sha256"},
        "generation_disposition": {"const": "preserve_untouched"}
      }
    },
    "compensationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "transaction_id", "restore_order", "remove_if_created", "restore_artifacts", "required_offline_artifacts", "generation_disposition"],
      "properties": {
        "contract": {"const": "graphify.workspace.compensation_plan"},
        "schema_version": {"const": 1},
        "transaction_id": {"$ref": "#/$defs/uuid"},
        "restore_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolutePath"}
        },
        "remove_if_created": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolutePath"}
        },
        "restore_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "offline_artifact"],
            "properties": {
              "path": {"$ref": "#/$defs/absolutePath"},
