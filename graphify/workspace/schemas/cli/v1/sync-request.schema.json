{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/sync-request.schema.json",
  "title": "Graphify workspace code-only sync request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "cli_contract_version",
    "mode",
    "repo_uuid",
    "generation_id",
    "expected_registry_revision",
    "expected_active_source_revision",
    "expected_operation_epoch",
    "expected_migration_epoch",
    "expected_pointer_revision",
    "expected_current_receipt_sha256",
    "source_epoch",
    "semantic_desired_watermark",
    "expected_payload_bytes",
    "capacity_policy"
  ],
  "properties": {
    "contract": {"const": "graphify.workspace.sync_request"},
    "schema_version": {"const": 1},
    "cli_contract_version": {"const": 1},
    "mode": {"const": "code_only"},
    "repo_uuid": {"type": "string", "format": "uuid"},
    "generation_id": {
      "type": "string",
      "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "expected_registry_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_active_source_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_operation_epoch": {"$ref": "#/$defs/positive_integer"},
    "expected_migration_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_pointer_revision": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_current_receipt_sha256": {"$ref": "#/$defs/nullable_digest"},
    "source_epoch": {"$ref": "#/$defs/positive_integer"},
    "semantic_desired_watermark": {"$ref": "#/$defs/positive_integer"},
    "expected_payload_bytes": {"$ref": "#/$defs/positive_integer"},
    "capacity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_max_bytes",
        "global_max_generations",
        "workspace_max_bytes",
        "workspace_max_generations",
        "reserve_bytes"
      ],
      "properties": {
        "global_max_bytes": {"$ref": "#/$defs/positive_integer"},
        "global_max_generations": {"$ref": "#/$defs/positive_integer"},
        "workspace_max_bytes": {"$ref": "#/$defs/positive_integer"},
        "workspace_max_generations": {"$ref": "#/$defs/positive_integer"},
        "reserve_bytes": {"$ref": "#/$defs/positive_integer"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"expected_pointer_revision": {"const": 0}},
        "required": ["expected_pointer_revision"]
      },
      "then": {
        "properties": {"expected_current_receipt_sha256": {"type": "null"}}
      },
      "else": {
        "properties": {"expected_current_receipt_sha256": {"$ref": "#/$defs/digest"}}
      }
    },
    {
      "if": {
        "properties": {"expected_current_receipt_sha256": {"type": "null"}},
        "required": ["expected_current_receipt_sha256"]
      },
      "then": {
        "properties": {"expected_pointer_revision": {"const": 0}}
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
