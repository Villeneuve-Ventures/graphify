{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/gc-execute-request.schema.json",
  "title": "Graphify workspace fenced GC execute request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["approved_preview_sha256", "authorization", "capacity_policy", "cli_contract_version", "contract", "expected_active_source_revision", "expected_migration_epoch", "expected_operation_epoch", "expected_pointer_revision", "expected_registry_revision", "protections", "repo_uuid", "schema_version", "timeout_ms"],
  "properties": {
    "approved_preview_sha256": {"$ref": "#/$defs/digest"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "capacity_policy": {"$ref": "#/$defs/capacity_policy"},
    "cli_contract_version": {"const": 1},
    "contract": {"const": "graphify.workspace.gc_execute_request"},
    "expected_active_source_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_migration_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_operation_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_pointer_revision": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_registry_revision": {"$ref": "#/$defs/positive_integer"},
    "protections": {"$ref": "#/$defs/protections"},
    "repo_uuid": {"$ref": "#/$defs/uuid"},
    "schema_version": {"const": 1},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
  },
  "$defs": {
    "authorization": {"type": "object", "additionalProperties": false, "required": ["action", "issued_at", "nonce", "operator_id", "reason"], "properties": {"action": {"const": "GC_EXECUTE"}, "issued_at": {"$ref": "#/$defs/date_time"}, "nonce": {"$ref": "#/$defs/trimmed_nonempty_string"}, "operator_id": {"$ref": "#/$defs/trimmed_nonempty_string"}, "reason": {"$ref": "#/$defs/trimmed_nonempty_string"}}},
    "capacity_policy": {"type": "object", "additionalProperties": false, "required": ["contract", "format_version", "global_max_bytes", "global_max_generations", "workspace_max_bytes", "workspace_max_generations", "reserve_bytes"], "properties": {"contract": {"const": "graphify.workspace.capacity_policy.internal"}, "format_version": {"const": 1}, "global_max_bytes": {"$ref": "#/$defs/positive_integer"}, "global_max_generations": {"$ref": "#/$defs/positive_integer"}, "workspace_max_bytes": {"$ref": "#/$defs/positive_integer"}, "workspace_max_generations": {"$ref": "#/$defs/positive_integer"}, "reserve_bytes": {"$ref": "#/$defs/positive_integer"}}, "description": "Cross-field capacity relationships are enforced by the runtime."},
    "date_time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_id": {"type": "string", "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"},
    "generation_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_id"}, "description": "Generation IDs must be supplied in canonical sorted order."},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "protections": {"type": "object", "additionalProperties": false, "required": ["active_lease_generations", "fixture_generations", "migration_sources", "proof_generations", "rollback_artifact_generations", "rollback_sources"], "properties": {"active_lease_generations": {"$ref": "#/$defs/generation_ids"}, "fixture_generations": {"$ref": "#/$defs/generation_ids"}, "migration_sources": {"$ref": "#/$defs/generation_ids"}, "proof_generations": {"$ref": "#/$defs/generation_ids"}, "rollback_artifact_generations": {"$ref": "#/$defs/generation_ids"}, "rollback_sources": {"$ref": "#/$defs/generation_ids"}}},
    "trimmed_nonempty_string": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"},
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
