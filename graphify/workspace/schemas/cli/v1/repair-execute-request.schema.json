{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/repair-execute-request.schema.json",
  "title": "Graphify workspace fenced pointer-repair execute request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved_preview_sha256",
    "authorization",
    "cli_contract_version",
    "contract",
    "expected_active_source_revision",
    "expected_migration_epoch",
    "expected_operation_epoch",
    "expected_registry_revision",
    "repo_uuid",
    "schema_version",
    "timeout_ms"
  ],
  "properties": {
    "approved_preview_sha256": {"$ref": "#/$defs/digest"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "cli_contract_version": {"const": 1},
    "contract": {"const": "graphify.workspace.repair_execute_request"},
    "expected_active_source_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_migration_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_operation_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_registry_revision": {"$ref": "#/$defs/positive_integer"},
    "repo_uuid": {"$ref": "#/$defs/uuid"},
    "schema_version": {"const": 1},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
  },
  "$defs": {
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "issued_at", "nonce", "operator_id", "reason"],
      "properties": {
        "action": {"const": "REPAIR_EXECUTE"},
        "issued_at": {"$ref": "#/$defs/date_time"},
        "nonce": {"$ref": "#/$defs/trimmed_nonempty_string"},
        "operator_id": {"$ref": "#/$defs/trimmed_nonempty_string"},
        "reason": {"$ref": "#/$defs/trimmed_nonempty_string"}
      }
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "trimmed_nonempty_string": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"},
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
