{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/rollback-request.schema.json",
  "title": "Graphify workspace exact last-good rollback request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "cli_contract_version",
    "repo_uuid",
    "expected_registry_revision",
    "expected_active_source_revision",
    "expected_operation_epoch",
    "expected_migration_epoch",
    "expected_pointer_revision",
    "expected_current_receipt_sha256",
    "target_generation_id",
    "target_receipt_sha256",
    "target_source_epoch",
    "authorization"
  ],
  "properties": {
    "contract": {"const": "graphify.workspace.rollback_request"},
    "schema_version": {"const": 1},
    "cli_contract_version": {"const": 1},
    "repo_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_registry_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_active_source_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_operation_epoch": {"$ref": "#/$defs/positive_integer"},
    "expected_migration_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_pointer_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775806
    },
    "expected_current_receipt_sha256": {"$ref": "#/$defs/digest"},
    "target_generation_id": {
      "type": "string",
      "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "target_receipt_sha256": {"$ref": "#/$defs/digest"},
    "target_source_epoch": {"$ref": "#/$defs/positive_integer"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "issued_at", "nonce", "operator_id", "reason"],
      "properties": {
        "action": {"const": "ROLLBACK"},
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "nonce": {"$ref": "#/$defs/trimmed_nonempty_string"},
        "operator_id": {"$ref": "#/$defs/trimmed_nonempty_string"},
        "reason": {"$ref": "#/$defs/trimmed_nonempty_string"}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "trimmed_nonempty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    }
  }
}
