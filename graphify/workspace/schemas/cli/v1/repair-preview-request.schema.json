{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/repair-preview-request.schema.json",
  "title": "Graphify workspace pointer-repair preview request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cli_contract_version",
    "contract",
    "expected_active_source_revision",
    "expected_migration_epoch",
    "expected_operation_epoch",
    "expected_registry_revision",
    "repo_uuid",
    "schema_version",
    "timeout_ms"
  ],
  "properties": {
    "cli_contract_version": {"const": 1},
    "contract": {"const": "graphify.workspace.repair_preview_request"},
    "expected_active_source_revision": {"$ref": "#/$defs/positive_integer"},
    "expected_migration_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_operation_epoch": {"$ref": "#/$defs/nonnegative_integer"},
    "expected_registry_revision": {"$ref": "#/$defs/positive_integer"},
    "repo_uuid": {"$ref": "#/$defs/uuid"},
    "schema_version": {"const": 1},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
  },
  "$defs": {
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
