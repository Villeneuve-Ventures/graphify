{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify.dev/schemas/workspace/cli/v1/repair-execute-result.schema.json",
  "title": "Graphify workspace fenced pointer-repair execute result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cli_contract_version",
    "contract",
    "schema_version",
    "state"
  ],
  "properties": {
    "action_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_preview_sha256": {"$ref": "#/$defs/digest"},
    "cli_contract_version": {"const": 1},
    "contract": {"const": "graphify.workspace.repair_execute_result"},
    "current": {"$ref": "#/$defs/generation_reference"},
    "exit_code": {"enum": [10, 20]},
    "last_good": {"$ref": "#/$defs/nullable_generation_reference"},
    "pointer_revision": {"$ref": "#/$defs/positive_integer"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "repo_uuid": {"$ref": "#/$defs/uuid"},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "schema_version": {"const": 1},
    "state": {"enum": ["repaired", "no_op", "conflict", "invalid", "unsupported"]}
  },
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_id": {"type": "string", "pattern": "^gen-[a-z0-9][a-z0-9._-]{0,62}$"},
    "generation_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "receipt_sha256"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/generation_id"},
        "receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "nullable_generation_reference": {
      "anyOf": [
        {"$ref": "#/$defs/generation_reference"},
        {"type": "null"}
      ]
    },
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "success": {
      "properties": {"state": {"enum": ["repaired", "no_op"]}},
      "required": ["approved_preview_sha256", "current", "last_good", "pointer_revision", "repo_uuid", "request_sha256"],
      "not": {"anyOf": [{"required": ["action_code"]}, {"required": ["exit_code"]}, {"required": ["reason_code"]}]}
    },
    "failure": {
      "properties": {"state": {"enum": ["conflict", "invalid", "unsupported"]}},
      "required": ["action_code", "exit_code", "reason_code"],
      "allOf": [
        {"if": {"properties": {"state": {"const": "conflict"}}, "required": ["state"]}, "then": {"properties": {"exit_code": {"const": 10}}}},
        {"if": {"properties": {"state": {"enum": ["invalid", "unsupported"]}}, "required": ["state"]}, "then": {"properties": {"exit_code": {"const": 20}}}}
      ],
      "not": {
        "anyOf": [
          {"required": ["approved_preview_sha256"]},
          {"required": ["current"]},
          {"required": ["last_good"]},
          {"required": ["pointer_revision"]},
          {"required": ["repo_uuid"]},
          {"required": ["request_sha256"]}
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
